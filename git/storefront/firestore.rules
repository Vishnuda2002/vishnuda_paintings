rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == 'vishnudaprakashrajaa.2002@gmail.com';}
  match /products/{id} {
   allow read: if true;
   allow create, update: if admin() && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.stock is int && request.resource.data.stock >= 0;
   allow delete: if admin();
  }
  match /orders/{id} {
   allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.paymentStatus == 'Pending verification' && request.resource.data.status == 'Payment pending' && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.paymentReference is string && request.resource.data.paymentProof is string;
   allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
   allow update: if admin();
   allow delete: if false;
  }
  match /users/{id} { allow read, write: if signedIn() && (request.auth.uid == id || admin()); }
 }
}
